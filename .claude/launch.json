{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "mkdocs-lrs",
      "runtimeExecutable": "mkdocs",
      "runtimeArgs": [
        "serve",
        "-a",
        "127.0.0.1:8010"
      ],
      "port": 8010
    },
    {
      "name": "docs-static",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8766",
        "--bind",
        "127.0.0.1",
        "--directory",
        "docs"
      ],
      "port": 8766
    }
  ]
}
